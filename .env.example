# Copy to .env.local and fill with values from Supabase Dashboard > Project Settings > API.
# Never commit .env.local (see .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App configuration (PRD section 17, 20, 27)
APP_TIMEZONE=Asia/Jakarta
ATTENDANCE_START_TIME=08:00
ATTENDANCE_GRACE_MINUTES=0
DEFAULT_ANNUAL_LEAVE=12
